{
  "name": "game-hub",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:client": "vite",
    "dev:server": "node --import tsx server/index.ts",
    "preview:prod": "npm run build && npm run build:server && npm start",
    "build": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "start": "NODE_ENV=production node dist-server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:ai": "esbuild scripts/ai-bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ai-bench.mjs --log-level=warning && node node_modules/.cache/ai-bench.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "0.186.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
